// ============================================================================
// LUMO CONNECT — Authoritative PostgreSQL Schema
// Modular monolith: single database, role-based access per portal
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS — Identity & Access
// ============================================================================

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  CLOSED
}

enum RoleScope {
  PLATFORM
  ORGANIZATION
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum VerificationCaseStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum VerificationCaseType {
  INDIVIDUAL_KYC
  BUSINESS_KYB
  DOCUMENT_RESUBMISSION
}

// ============================================================================
// ENUMS — Marketplace & Opportunities
// ============================================================================

enum OpportunityType {
  PRODUCT_SALES
  QUALIFIED_LEADS
  CONTENT_CREATION
  CUSTOMER_ACQUISITION
  DISTRIBUTOR_SEARCH
  B2B_INTRODUCTION
  REVERSE_SOURCING
  SUBSCRIPTION_PROMOTION
  MILESTONE_BOUNTY
  ADVERTISING_CAMPAIGN
}

enum OpportunityStatus {
  DRAFT
  UNDER_REVIEW
  RETURNED
  REJECTED
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ParticipationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  TERMINATED
}

enum TrackingAssetType {
  LINK
  QR_CODE
  PROMO_CODE
  API_KEY
}

enum TrackingAssetStatus {
  ACTIVE
  PAUSED
  REVOKED
  EXPIRED
}

enum LeadValidationStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  REJECTED
  DUPLICATE
}

enum ConversionStatus {
  TRACKED
  PENDING
  VALIDATING
  APPROVED
  PAYABLE
  PAID
  ON_HOLD
  REJECTED
  REVERSED
  DISPUTED
  EXPIRED
}

enum EvidenceType {
  SCREENSHOT
  RECEIPT
  INVOICE
  DELIVERY_PROOF
  VIDEO
  API_WEBHOOK
  MANUAL_ENTRY
}

// ============================================================================
// ENUMS — Rewards & Payments
// ============================================================================

enum RewardType {
  PERCENTAGE_COMMISSION
  FIXED_COMMISSION
  COST_PER_LEAD
  COST_PER_ACQUISITION
  FIXED_CAMPAIGN_FEE
  TIERED_COMMISSION
  MILESTONE_BONUS
  HYBRID
}

enum RewardStatus {
  TRACKED
  PENDING
  VALIDATING
  APPROVED
  PAYABLE
  PAID
  REJECTED
  REVERSED
}

enum AdjustmentType {
  BONUS
  PENALTY
  CORRECTION
  TAX_ADJUSTMENT
  PLATFORM_FEE
  REVERSAL
}

enum PaymentPurpose {
  SUBSCRIPTION
  WALLET_TOPUP
  REWARD_FUNDING
  PLATFORM_FEE
}

enum PaymentStatus {
  CREATED
  INITIATED
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  EXPIRED
  REVERSED
  REFUNDED
}

enum FundingTransactionType {
  DEPOSIT
  COMMITMENT
  RELEASE
  REFUND
  FEE_DEDUCTION
  WITHDRAWAL
}

enum FundingTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum PayoutStatus {
  DRAFT
  PENDING_APPROVAL
  AUTHORIZED
  PROCESSING
  PAID
  FAILED
  REVERSED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  FAILED
}

// ============================================================================
// ENUMS — Risk, Disputes & Audit
// ============================================================================

enum RiskAlertStatus {
  OPEN
  INVESTIGATING
  DISMISSED
  ESCALATED
  RESOLVED
}

enum FraudCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudCaseStatus {
  OPEN
  INVESTIGATING
  RESOLVED_CONFIRMED
  RESOLVED_FALSE_POSITIVE
  CLOSED
}

enum DisputeType {
  CONVERSION_CHALLENGE
  REWARD_DISPUTE
  TERMS_DISAGREEMENT
  PAYMENT_ISSUE
  PARTNER_CONDUCT
}

enum DisputeStatus {
  OPENED
  UNDER_REVIEW
  EVIDENCE_SUBMITTED
  RESOLVED_PARTNER_FAVOR
  RESOLVED_BUSINESS_FAVOR
  CLOSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

// ============================================================================
// 1. IDENTITY & AUTHENTICATION
// ============================================================================

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  emailVerified Boolean       @default(false)
  phone         String?       @unique
  phoneVerified Boolean       @default(false)
  name          String
  image         String?
  accountStatus AccountStatus @default(PENDING_VERIFICATION)
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  // Better Auth relations
  sessions      Session[]
  accounts      Account[]

  // LUMO domain relations
  partnerProfile    PartnerProfile?
  roleAssignments   RoleAssignment[]
  memberships       OrganizationMember[]
  applications      OpportunityApplication[]
  participations    DealParticipation[]
  subscriptions     UserSubscription[]
  enterpriseInquiries EnterpriseInquiry[]
  paymentAttempts   PaymentAttempt[]
  payoutMethods     PayoutMethod[]
  payoutsReceived   Payout[]
  rewards           Reward[]
  sentMessages      DealMessage[]          @relation("MessageSender")
  disputesOpened    Dispute[]              @relation("DisputeOpener")
  disputeMessages   DisputeMessage[]       @relation("DisputeMessageSender")
  verificationCasesUser VerificationCase[] @relation("VerificationUser")
  verificationDecisions VerificationDecision[] @relation("DecisionMaker")
  riskAlertsSubject RiskAlert[]            @relation("RiskAlertUser")
  fraudCasesAssigned FraudCase[]           @relation("FraudCaseAssignee")
  notifications     Notification[]
  auditLogs         AuditLog[]             @relation("AuditActor")
  uploadedFiles     FileAsset[]            @relation("FileUploader")

  @@index([email])
  @@index([phone])
  @@index([accountStatus])
  @@map("users")
}

/// Better Auth OAuth provider accounts
model Account {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Better Auth sessions
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

/// Better Auth email/phone verification tokens
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verifications")
}

model PartnerProfile {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @db.Uuid
  handle             String  @unique
  bio                String?
  countryCode        String  @default("TZ")
  region             String?
  partnerType        String  // CREATOR, AFFILIATE, DISTRIBUTOR, SALES_AGENT, B2B_BROKER, AGENCY
  categories         String[] // [SOLAR, FINTECH, HOSPITALITY, ECOMMERCE]
  socialChannels     Json?
  audienceSize       Int?
  verificationStatus String  @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  partnerScore       Decimal @default(50) @db.Decimal(5, 2)
  taxClassification  String  @default("INDIVIDUAL_RESIDENT")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handle])
  @@index([verificationStatus])
  @@map("partner_profiles")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  name        String
  scope       RoleScope @default(PLATFORM)
  description String?
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments RoleAssignment[]

  @@map("roles")
}

model RoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  organizationId String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@map("role_assignments")
}

// ============================================================================
// 2. ORGANIZATIONS
// ============================================================================

model Organization {
  id                 String   @id @default(uuid()) @db.Uuid
  legalName          String
  tradingName        String?
  slug               String   @unique
  tin                String?
  registrationNumber String?
  countryCode        String   @default("TZ")
  logoUrl            String?
  verificationStatus String   @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  members             OrganizationMember[]
  roleAssignments     RoleAssignment[]
  opportunities       Opportunity[]
  fundingAccount      RewardFundingAccount?
  verificationCases   VerificationCase[]     @relation("VerificationOrg")
  riskAlerts          RiskAlert[]            @relation("RiskAlertOrg")

  @@index([slug])
  @@index([verificationStatus])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  businessRole   String       @default("STAFF") // OWNER, ADMIN, STAFF, FINANCE, VIEWER
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ============================================================================
// 3. MARKETPLACE — Opportunities, Versions, Applications, Participation
// ============================================================================

model OpportunityCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  opportunities Opportunity[]

  @@map("opportunity_categories")
}

model Opportunity {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  categoryId         String?           @db.Uuid
  opportunityType    OpportunityType
  title              String
  slug               String            @unique
  summary            String
  description        String            @db.Text
  region             String?
  countryCode        String            @default("TZ")
  coverImageUrl      String?
  promoVideoUrl      String?
  galleryImageUrls   String[]
  isFeatured         Boolean           @default(false)
  status             OpportunityStatus @default(DRAFT)
  publishedVersionId String?           @db.Uuid
  totalBudgetMinor   BigInt?
  spentBudgetMinor   BigInt            @default(0)
  currency           String            @default("TZS")
  maxPartners        Int?
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        OpportunityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedVersion OpportunityVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions        OpportunityVersion[] @relation("OpportunityVersions")
  applications    OpportunityApplication[]
  participations  DealParticipation[]
  conversions     Conversion[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([opportunityType])
  @@index([status])
  @@index([slug])
  @@map("opportunities")
}

model OpportunityVersion {
  id              String   @id @default(uuid()) @db.Uuid
  opportunityId   String   @db.Uuid
  versionNumber   Int
  title           String
  description     String   @db.Text
  termsHash       String   // SHA-256 hash of canonical terms for tamper detection
  rewardSummary   String?  // Human-readable reward description
  attributionWindowDays Int @default(30)
  attributionModel String  @default("LAST_CLICK")
  termsAndConditions String @db.Text
  isExclusive     Boolean  @default(false)
  requiresApproval Boolean @default(true)
  effectiveAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  opportunity             Opportunity         @relation("OpportunityVersions", fields: [opportunityId], references: [id], onDelete: Cascade)
  publishedForOpportunity Opportunity[]        @relation("PublishedVersion")
  rewardRules             RewardRule[]
  lockedParticipations    DealParticipation[]  @relation("LockedTerms")

  @@unique([opportunityId, versionNumber])
  @@index([opportunityId])
  @@map("opportunity_versions")
}

model RewardRule {
  id                    String     @id @default(uuid()) @db.Uuid
  opportunityVersionId  String     @db.Uuid
  rewardType            RewardType
  amountMinor           BigInt?    // Fixed amount in minor units
  percentageBps         Int?       // Basis points: 1000 = 10.00%
  minQualifyingValueMinor BigInt?  // Minimum order/lead value to qualify
  tierMinCount          Int?       // For tiered: minimum count threshold
  tierMaxCount          Int?       // For tiered: maximum count threshold
  description           String
  currency              String     @default("TZS")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  opportunityVersion OpportunityVersion @relation(fields: [opportunityVersionId], references: [id], onDelete: Cascade)
  rewards            Reward[]

  @@index([opportunityVersionId])
  @@map("reward_rules")
}

model OpportunityApplication {
  id              String            @id @default(uuid()) @db.Uuid
  opportunityId   String            @db.Uuid
  partnerUserId   String            @db.Uuid
  status          ApplicationStatus @default(PENDING)
  proposalNotes   String?           @db.Text
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  submittedAt     DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  opportunity  Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  partnerUser  User        @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  participation DealParticipation?

  @@unique([opportunityId, partnerUserId])
  @@index([opportunityId])
  @@index([partnerUserId])
  @@index([status])
  @@map("opportunity_applications")
}

/// Critical model: `acceptedVersionId` preserves the exact commercial terms
/// accepted by the Partner, even if the Business later creates a new version.
model DealParticipation {
  id                String              @id @default(uuid()) @db.Uuid
  opportunityId     String              @db.Uuid
  partnerUserId     String              @db.Uuid
  acceptedVersionId String              @db.Uuid
  applicationId     String?             @unique @db.Uuid
  status            ParticipationStatus @default(ACTIVE)
  joinedAt          DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  opportunity     Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  partnerUser     User                   @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  acceptedVersion OpportunityVersion     @relation("LockedTerms", fields: [acceptedVersionId], references: [id], onDelete: Restrict)
  application     OpportunityApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  trackingAssets  TrackingAsset[]
  leads           Lead[]
  conversions     Conversion[]
  dealRoom        DealRoom?
  disputes        Dispute[]

  @@unique([opportunityId, partnerUserId])
  @@index([opportunityId])
  @@index([partnerUserId])
  @@index([acceptedVersionId])
  @@index([status])
  @@map("deal_participations")
}

// ============================================================================
// 4. TRACKING, LEADS & CONVERSIONS
// ============================================================================

model TrackingAsset {
  id              String              @id @default(uuid()) @db.Uuid
  participationId String              @db.Uuid
  assetType       TrackingAssetType   @default(LINK)
  code            String              @unique
  destinationUrl  String?
  qrCodeUrl       String?
  campaignName    String?
  clickCount      Int                 @default(0)
  uniqueClicks    Int                 @default(0)
  status          TrackingAssetStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  participation DealParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  conversions   Conversion[]

  @@index([participationId])
  @@index([code])
  @@map("tracking_assets")
}

model Lead {
  id                String               @id @default(uuid()) @db.Uuid
  participationId   String               @db.Uuid
  externalReference String?
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  leadScore         Int                  @default(50)
  validationStatus  LeadValidationStatus @default(NEW)
  metadata          Json?
  convertedConversionId String?          @unique @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  participation      DealParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  convertedConversion Conversion?       @relation("LeadConversion", fields: [convertedConversionId], references: [id], onDelete: SetNull)

  @@index([participationId])
  @@index([validationStatus])
  @@map("leads")
}

model Conversion {
  id                String           @id @default(uuid()) @db.Uuid
  participationId   String           @db.Uuid
  opportunityId     String           @db.Uuid
  trackingAssetId   String?          @db.Uuid
  externalReference String?
  valueMinor        BigInt           // Gross order/transaction value in minor units
  currency          String           @default("TZS")
  status            ConversionStatus @default(TRACKED)
  riskScore         Int              @default(0) // 0–100
  occurredAt        DateTime         @default(now())
  idempotencyKey    String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  participation DealParticipation  @relation(fields: [participationId], references: [id], onDelete: Cascade)
  opportunity   Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  trackingAsset TrackingAsset?     @relation(fields: [trackingAssetId], references: [id], onDelete: SetNull)
  evidence      ConversionEvidence[]
  rewards       Reward[]
  riskAlerts    RiskAlert[]        @relation("RiskAlertConversion")
  leadSource    Lead?              @relation("LeadConversion")

  @@index([participationId])
  @@index([opportunityId])
  @@index([trackingAssetId])
  @@index([status])
  @@index([externalReference])
  @@map("conversions")
}

model ConversionEvidence {
  id           String       @id @default(uuid()) @db.Uuid
  conversionId String       @db.Uuid
  fileAssetId  String?      @db.Uuid
  evidenceType EvidenceType
  notes        String?
  createdAt    DateTime     @default(now())

  conversion Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset? @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([conversionId])
  @@map("conversion_evidence")
}

// ============================================================================
// 5. DEAL ROOMS
// ============================================================================

model DealRoom {
  id              String   @id @default(uuid()) @db.Uuid
  participationId String   @unique @db.Uuid
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participation DealParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  messages      DealMessage[]
  documents     DealDocument[]

  @@map("deal_rooms")
}

model DealMessage {
  id         String   @id @default(uuid()) @db.Uuid
  dealRoomId String   @db.Uuid
  senderId   String   @db.Uuid
  content    String   @db.Text
  createdAt  DateTime @default(now())

  dealRoom DealRoom @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([dealRoomId])
  @@index([senderId])
  @@map("deal_messages")
}

model DealDocument {
  id          String   @id @default(uuid()) @db.Uuid
  dealRoomId  String   @db.Uuid
  fileAssetId String   @db.Uuid
  label       String?
  createdAt   DateTime @default(now())

  dealRoom  DealRoom  @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([dealRoomId])
  @@map("deal_documents")
}

// ============================================================================
// 6. SUBSCRIPTIONS
// ============================================================================

model SubscriptionPlan {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  billingPeriod  String   // MONTHLY, SEMI_ANNUALLY, ANNUALLY
  priceMinor     BigInt
  currency       String   @default("TZS")
  enterprise     Boolean  @default(false)
  features       String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  planId      String             @db.Uuid
  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime?
  expiresAt   DateTime?
  cancelledAt DateTime?
  autoRenew   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("user_subscriptions")
}

model PaymentAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  purpose           PaymentPurpose
  amountMinor       BigInt
  currency          String        @default("TZS")
  provider          String        // MONGIKE, STRIPE, MANUAL
  providerReference String?       @unique
  paymentMethod     String?       // MPESA, AIRTEL_MONEY, TIGO_PESA, CARD
  idempotencyKey    String        @unique
  status            PaymentStatus @default(CREATED)
  errorMessage      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundingTransactions  FundingTransaction[]
  reconciliationItems  ReconciliationItem[] @relation("ReconPayment")

  @@index([userId])
  @@index([idempotencyKey])
  @@index([providerReference])
  @@index([status])
  @@map("payment_attempts")
}

model EnterpriseInquiry {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String?  @db.Uuid
  businessName       String
  workEmail          String
  phoneNumber        String
  teamSize           String
  industry           String
  expectedDealVolume String
  aiRequirements     String?
  message            String   @db.Text
  status             String   @default("PENDING") // PENDING, CONTACTED, AGREED, DECLINED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workEmail])
  @@index([status])
  @@map("enterprise_inquiries")
}

// ============================================================================
// 7. REWARD FUNDING & ESCROW
// ============================================================================

model RewardFundingAccount {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @unique @db.Uuid
  providerAccountReference  String?
  currency                  String   @default("TZS")
  status                    String   @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions FundingTransaction[]

  @@map("reward_funding_accounts")
}

model FundingTransaction {
  id                 String                    @id @default(uuid()) @db.Uuid
  fundingAccountId   String                    @db.Uuid
  amountMinor        BigInt
  currency           String                    @default("TZS")
  transactionType    FundingTransactionType
  providerReference  String?                   @unique
  paymentAttemptId   String?                   @db.Uuid
  description        String?
  status             FundingTransactionStatus  @default(PENDING)
  idempotencyKey     String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  fundingAccount  RewardFundingAccount @relation(fields: [fundingAccountId], references: [id], onDelete: Cascade)
  paymentAttempt  PaymentAttempt?      @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  reconciliationItems ReconciliationItem[] @relation("ReconFunding")

  @@index([fundingAccountId])
  @@index([providerReference])
  @@index([status])
  @@map("funding_transactions")
}

// ============================================================================
// 8. REWARDS & PAYOUTS
// ============================================================================

model Reward {
  id               String       @id @default(uuid()) @db.Uuid
  conversionId     String       @db.Uuid
  rewardRuleId     String       @db.Uuid
  partnerUserId    String       @db.Uuid
  grossAmountMinor BigInt
  platformFeeMinor BigInt       @default(0)
  taxWithheldMinor BigInt       @default(0)
  netAmountMinor   BigInt
  currency         String       @default("TZS")
  status           RewardStatus @default(TRACKED)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  conversion  Conversion       @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  rewardRule  RewardRule        @relation(fields: [rewardRuleId], references: [id], onDelete: Restrict)
  partnerUser User              @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  adjustments RewardAdjustment[]
  payoutItems PayoutItem[]

  @@unique([conversionId, rewardRuleId, partnerUserId])
  @@index([conversionId])
  @@index([rewardRuleId])
  @@index([partnerUserId])
  @@index([status])
  @@map("rewards")
}

model RewardAdjustment {
  id             String         @id @default(uuid()) @db.Uuid
  rewardId       String         @db.Uuid
  amountMinor    BigInt
  currency       String         @default("TZS")
  reason         String
  adjustmentType AdjustmentType
  actorId        String?
  createdAt      DateTime       @default(now())

  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([rewardId])
  @@map("reward_adjustments")
}

model PayoutMethod {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String   // MPESA, AIRTEL_MONEY, TIGO_PESA, BANK
  accountNumber   String   @db.Text // Encrypted at app layer
  accountName     String   @db.Text // Encrypted at app layer
  bankName        String?
  branchCode      String?
  isDefault       Boolean  @default(false)
  isVerified      Boolean  @default(false)
  currency        String   @default("TZS")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@index([userId])
  @@map("payout_methods")
}

model Payout {
  id                 String       @id @default(uuid()) @db.Uuid
  partnerUserId      String       @db.Uuid
  payoutMethodId     String       @db.Uuid
  grossAmountMinor   BigInt
  platformFeeMinor   BigInt       @default(0)
  taxWithheldMinor   BigInt       @default(0)
  netAmountMinor     BigInt
  currency           String       @default("TZS")
  providerReference  String?      @unique
  providerBatchRef   String?
  idempotencyKey     String       @unique
  status             PayoutStatus @default(DRAFT)
  authorizedBy       String?
  authorizedAt       DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  partnerUser   User              @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)
  payoutMethod  PayoutMethod      @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  items         PayoutItem[]
  reconciliationItems ReconciliationItem[] @relation("ReconPayout")

  @@index([partnerUserId])
  @@index([status])
  @@index([providerReference])
  @@map("payouts")
}

model PayoutItem {
  id                  String   @id @default(uuid()) @db.Uuid
  payoutId            String   @db.Uuid
  rewardId            String   @db.Uuid
  allocatedAmountMinor BigInt
  currency            String   @default("TZS")
  createdAt           DateTime @default(now())

  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@unique([payoutId, rewardId])
  @@index([payoutId])
  @@index([rewardId])
  @@map("payout_items")
}

// ============================================================================
// 9. DOUBLE-ENTRY LEDGER
// ============================================================================

model LedgerAccount {
  id          String   @id @default(uuid()) @db.Uuid
  accountCode String   @unique
  name        String
  ownerType   String?  // PLATFORM, ORGANIZATION, PARTNER
  ownerId     String?  @db.Uuid
  currency    String   @default("TZS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  journalLines JournalLine[]

  @@index([accountCode])
  @@index([ownerType, ownerId])
  @@map("ledger_accounts")
}

model JournalEntry {
  id         String   @id @default(uuid()) @db.Uuid
  sourceType String   // REWARD, PAYOUT, FUNDING, FEE, ADJUSTMENT
  sourceId   String   @db.Uuid
  narration  String?
  postedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  lines JournalLine[]

  @@index([sourceType, sourceId])
  @@index([postedAt])
  @@map("journal_entries")
}

model JournalLine {
  id               String   @id @default(uuid()) @db.Uuid
  journalEntryId   String   @db.Uuid
  ledgerAccountId  String   @db.Uuid
  debitMinor       BigInt   @default(0)
  creditMinor      BigInt   @default(0)
  currency         String   @default("TZS")
  createdAt        DateTime @default(now())

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([ledgerAccountId])
  @@map("journal_lines")
}

// ============================================================================
// 10. RECONCILIATION
// ============================================================================

model ReconciliationRun {
  id            String   @id @default(uuid()) @db.Uuid
  runDate       DateTime @default(now())
  status        String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, FAILED
  matchedCount  Int      @default(0)
  unmatchedCount Int     @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  items ReconciliationItem[]

  @@index([runDate])
  @@map("reconciliation_runs")
}

model ReconciliationItem {
  id                    String   @id @default(uuid()) @db.Uuid
  reconciliationRunId   String   @db.Uuid
  paymentAttemptId      String?  @db.Uuid
  fundingTransactionId  String?  @db.Uuid
  payoutId              String?  @db.Uuid
  matchStatus           String   @default("PENDING") // PENDING, MATCHED, UNMATCHED, EXCEPTION
  notes                 String?
  createdAt             DateTime @default(now())

  reconciliationRun  ReconciliationRun  @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)
  paymentAttempt     PaymentAttempt?    @relation("ReconPayment", fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  fundingTransaction FundingTransaction? @relation("ReconFunding", fields: [fundingTransactionId], references: [id], onDelete: SetNull)
  payout             Payout?            @relation("ReconPayout", fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([reconciliationRunId])
  @@map("reconciliation_items")
}

// ============================================================================
// 11. VERIFICATION, RISK & FRAUD
// ============================================================================

model VerificationCase {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String?                @db.Uuid
  organizationId   String?                @db.Uuid
  verificationType VerificationCaseType
  status           VerificationCaseStatus @default(PENDING)
  expiresAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user         User?          @relation("VerificationUser", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation("VerificationOrg", fields: [organizationId], references: [id], onDelete: Cascade)
  documents    VerificationDocument[]
  decisions    VerificationDecision[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("verification_cases")
}

model VerificationDocument {
  id          String   @id @default(uuid()) @db.Uuid
  caseId      String   @db.Uuid
  fileAssetId String   @db.Uuid
  documentType String  // NIDA_FRONT, NIDA_BACK, TIN_CERT, BUSINESS_LICENSE, SELFIE
  createdAt   DateTime @default(now())

  verificationCase VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileAsset        FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@map("verification_documents")
}

model VerificationDecision {
  id          String   @id @default(uuid()) @db.Uuid
  caseId      String   @db.Uuid
  decidedById String   @db.Uuid
  outcome     String   // APPROVED, REJECTED, REQUIRES_RESUBMISSION
  reason      String?
  createdAt   DateTime @default(now())

  verificationCase VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  decidedBy        User             @relation("DecisionMaker", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@map("verification_decisions")
}

model RiskRule {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  ruleLogic   Json     // Configurable rule parameters
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  alerts RiskAlert[]

  @@map("risk_rules")
}

model RiskAlert {
  id             String          @id @default(uuid()) @db.Uuid
  ruleId         String?         @db.Uuid
  subjectType    String          // USER, CONVERSION, ORGANIZATION
  subjectId      String          @db.Uuid
  userId         String?         @db.Uuid
  organizationId String?         @db.Uuid
  conversionId   String?         @db.Uuid
  riskScore      Decimal         @db.Decimal(5, 2)
  reason         String
  evidence       Json?
  status         RiskAlertStatus @default(OPEN)
  dismissedBy    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  rule         RiskRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  user         User?         @relation("RiskAlertUser", fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation("RiskAlertOrg", fields: [organizationId], references: [id], onDelete: SetNull)
  conversion   Conversion?   @relation("RiskAlertConversion", fields: [conversionId], references: [id], onDelete: SetNull)
  fraudCaseLinks FraudCaseAlert[]

  @@index([ruleId])
  @@index([subjectType, subjectId])
  @@index([status])
  @@map("risk_alerts")
}

model FraudCase {
  id           String            @id @default(uuid()) @db.Uuid
  caseNumber   String            @unique
  priority     FraudCasePriority @default(MEDIUM)
  status       FraudCaseStatus   @default(OPEN)
  assignedTo   String?           @db.Uuid
  summary      String?           @db.Text
  resolution   String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignee   User?            @relation("FraudCaseAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  alertLinks FraudCaseAlert[]

  @@index([caseNumber])
  @@index([status])
  @@map("fraud_cases")
}

model FraudCaseAlert {
  id          String   @id @default(uuid()) @db.Uuid
  fraudCaseId String   @db.Uuid
  riskAlertId String   @db.Uuid
  createdAt   DateTime @default(now())

  fraudCase FraudCase @relation(fields: [fraudCaseId], references: [id], onDelete: Cascade)
  riskAlert RiskAlert @relation(fields: [riskAlertId], references: [id], onDelete: Cascade)

  @@unique([fraudCaseId, riskAlertId])
  @@map("fraud_case_alerts")
}

// ============================================================================
// 12. DISPUTES
// ============================================================================

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  participationId String        @db.Uuid
  openedById      String        @db.Uuid
  disputeType     DisputeType
  status          DisputeStatus @default(OPENED)
  title           String
  description     String        @db.Text
  resolutionNotes String?       @db.Text
  dueAt           DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  participation DealParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  openedBy      User              @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  messages      DisputeMessage[]
  evidence      DisputeEvidence[]

  @@index([participationId])
  @@index([openedById])
  @@index([status])
  @@map("disputes")
}

model DisputeMessage {
  id        String   @id @default(uuid()) @db.Uuid
  disputeId String   @db.Uuid
  senderId  String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  sender  User    @relation("DisputeMessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@index([senderId])
  @@map("dispute_messages")
}

model DisputeEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  disputeId   String   @db.Uuid
  fileAssetId String   @db.Uuid
  label       String?
  createdAt   DateTime @default(now())

  dispute   Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@map("dispute_evidence")
}

// ============================================================================
// 13. AUDIT, NOTIFICATIONS & INFRASTRUCTURE
// ============================================================================

/// Append-only audit log. Never update or delete rows.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   // e.g. "opportunity.publish", "reward.approve", "payout.authorize"
  entityType   String   // e.g. "Opportunity", "Reward", "Payout"
  entityId     String?  @db.Uuid
  beforeData   Json?
  afterData    Json?
  ipAddress    String?
  userAgent    String?
  correlationId String?
  createdAt    DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
  @@map("audit_logs")
}

model NotificationTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  channel       NotificationChannel @default(IN_APP)
  titleTemplate String
  bodyTemplate  String   @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  notifications Notification[]

  @@map("notification_templates")
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  templateId String?             @db.Uuid
  channel    NotificationChannel @default(IN_APP)
  title      String
  body       String              @db.Text
  linkUrl    String?
  isRead     Boolean             @default(false)
  createdAt  DateTime            @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

/// Object storage metadata registry. Actual files live in S3/MinIO.
model FileAsset {
  id          String   @id @default(uuid()) @db.Uuid
  uploaderId  String   @db.Uuid
  fileKey     String   @unique // S3 object key
  fileName    String
  mimeType    String
  fileSizeBytes Int
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  uploader             User                   @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  conversionEvidence   ConversionEvidence[]
  verificationDocuments VerificationDocument[]
  dealDocuments        DealDocument[]
  disputeEvidence      DisputeEvidence[]

  @@index([uploaderId])
  @@index([fileKey])
  @@map("file_assets")
}

/// Transactional outbox for reliable async processing.
/// Workers poll for unprocessed events and dispatch to external providers.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    // e.g. "reward.approved", "payout.authorized", "conversion.tracked"
  aggregateType String    // e.g. "Reward", "Payout", "Conversion"
  aggregateId   String    @db.Uuid
  payload       Json
  processedAt   DateTime?
  failedAt      DateTime?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())

  deliveries WebhookDelivery[]

  @@index([eventType])
  @@index([processedAt])
  @@index([createdAt])
  @@map("outbox_events")
}

/// Registered external webhook endpoints.
model WebhookEndpoint {
  id          String   @id @default(uuid()) @db.Uuid
  url         String
  provider    String   // MONGIKE, MESEJI, EXTERNAL_COMMERCE, CUSTOM
  secret      String   @db.Text // Signing secret for verification
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhook_endpoints")
}

/// Delivery log for outbox events dispatched to webhook endpoints.
model WebhookDelivery {
  id              String   @id @default(uuid()) @db.Uuid
  outboxEventId   String   @db.Uuid
  endpointId      String?  @db.Uuid
  httpStatus      Int?
  responseBody    String?  @db.Text
  deliveredAt     DateTime?
  failedAt        DateTime?
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())

  outboxEvent OutboxEvent      @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  endpoint    WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([outboxEventId])
  @@index([endpointId])
  @@map("webhook_deliveries")
}
